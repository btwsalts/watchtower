# Local development defaults to SQLite.
# For Docker Compose, use:
# DATABASE_URL=postgresql+psycopg://watchtower:change-me@db:5432/watchtower
DATABASE_URL=sqlite:///./watchtower.db
APP_ENV=development
# Replace with a unique random secret (32+ characters) before production.
# WATCHTOWER_JWT_SECRET=
# Comma-separated allowed browser origins; update this if you use a different frontend origin.
WATCHTOWER_CORS_ORIGINS=https://btwsalts.github.io,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Optional IP reputation enrichment. Keep this key on the API server only.
# Obtain a key at https://www.abuseipdb.com/register
# ABUSEIPDB_API_KEY=
