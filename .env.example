# Local development defaults to SQLite.
# For Docker Compose, use:
# DATABASE_URL=postgresql+psycopg://watchtower:change-me@db:5432/watchtower
DATABASE_URL=sqlite:///./watchtower.db
APP_ENV=development
# Replace with a unique random secret (32+ characters) before production.
# WATCHTOWER_JWT_SECRET=
LOG_LEVEL=INFO
