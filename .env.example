# Local development defaults to SQLite.
# For Docker Compose, use:
# DATABASE_URL=postgresql+psycopg://watchtower:change-me@db:5432/watchtower
DATABASE_URL=sqlite:///./watchtower.db
APP_ENV=development
# Optional shared bearer token for API access (use 32+ random characters).
# Required when APP_ENV=production; not a replacement for user accounts or tenant isolation.
# WATCHTOWER_API_TOKEN=
LOG_LEVEL=INFO
